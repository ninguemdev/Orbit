{
  "name": "@orbit/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "smoke": "tsx --env-file-if-exists=../../.env scripts/smoke.ts"
  },
  "dependencies": {
    "@orbit/catalog": "workspace:*",
    "@orbit/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
