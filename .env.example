# Copie para .env e ajuste. Nunca versionar .env.

# Servidor de jogo (Colyseus)
HOST=127.0.0.1
PORT=2567
# Origens HTTP/WS aceitas, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cookie de sessão só por HTTPS (padrão: true em NODE_ENV=production, false fora dela)
COOKIE_SECURE=false
# Número de proxies reversos à frente do servidor (0 = clientes diretos); define o IP usado nos limites
TRUST_PROXY=0

# Cliente web (Vite): endereço do servidor de jogo
VITE_SERVER_URL=http://127.0.0.1:2567

# PostgreSQL de desenvolvimento (infra/compose.dev.yml)
DATABASE_URL=postgres://orbit:orbit_dev_password@127.0.0.1:5432/orbit
